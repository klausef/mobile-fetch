# FETCH environment template. Copy to `.env` and fill in the values you have:
#   copy .env.example .env        (cp on macOS/Linux, copy on Windows)
#
# This file is tracked on purpose and holds no values (see `.gitignore`).
#
# How it is read:
#   * `bun` auto-loads `.env` into process.env for every `bun run` / `bun test`.
#   * Vite loads it too and exposes only the `VITE_*` names to the browser
#     bundle. Precedence: process env > `.env.local` > `.env`.
#   * The Convex CLI reads `.env.local` first, then `.env`.
#
# Everything under "Vite client" is PUBLIC once bundled — it ships to every
# visitor. The last section is never read from this file: those live on the
# Convex deployment.

# ── Vite client ─────────────────────────────────────────────────────────────

# Convex deployment URL, e.g. https://your-deployment.convex.cloud. The client
# pins its own default in src/lib/convex.ts, so this value only drives the
# mismatch warning at src/lib/convex.ts:25. Move both together.
VITE_CONVEX_URL=

# MapTiler key: vector tiles (street labels) and forward/reverse geocoding.
# Optional — blank falls back to OpenStreetMap raster tiles and Nominatim.
# https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=

# Which MapTiler style to draw, e.g. streets-v2, streets-v2-dark, basic-v2,
# dataviz. Optional; blank means streets-v2 (src/lib/map-service.ts:76).
VITE_MAPTILER_STYLE=

# OpenRouteService token for road-following directions instead of a straight
# line. HeiGIT-issued token for api.heigit.org. Optional
# (src/lib/map-service.ts:84).
VITE_ORS_KEY=

# VLY project id and monitoring URL. Optional; the app runs without both
# (src/instrumentation.tsx:72-73).
VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=

# ── Convex CLI (npx convex dev / convex deploy) ─────────────────────────────

# Deployment `npx convex dev` pushes functions to, e.g.
# your-deployment:prod. Blank = the CLI picks (local config, then
# interactive). Keep it in step with VITE_CONVEX_URL so functions and client
# talk to the same backend. `npx convex dev` fills this in for you.
CONVEX_DEPLOYMENT=

# Alternative to CONVEX_DEPLOYMENT — a project- or preview-scoped deploy key
# takes precedence when set.
# CONVEX_DEPLOY_KEY=

# ── Convex DEPLOYMENT variables — NOT read from this file ───────────────────
# Set these one at a time with `npx convex env set NAME value`; never bulk-load
# this file with `npx convex env set --from-file .env`, which would push the
# client keys above alongside them. Listed here only as documentation.
#
# CONVEX_SITE_URL            auto-provided by Convex on the deployment
#                             (src/convex/_generated/server.d.ts:32) — do not set.
# VLY_CONVEX_AUTH_ISSUER     auth issuer, default https://freebuff.com
#                             (src/convex/auth.config.ts:9).
# VLY_INTEGRATION_BASE_URL   integration gateway, default
#                             https://integrations.vly.ai (src/convex/auth/emailOtp.ts:37).
# VLY_INTEGRATION_KEY        integration key, no default — required for email
#                             OTP (src/convex/auth/emailOtp.ts:42).
# STRIPE_SECRET_KEY          all three are required before online payment can
# STRIPE_PUBLISHABLE_KEY     be offered (src/convex/lib/provider.ts).
# STRIPE_WEBHOOK_SECRET
