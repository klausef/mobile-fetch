{
  "expo": {
    "name": "FETCH",
    "slug": "fetch-transport",
    "scheme": "fetch",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fetch.app"
    },
    "android": {
      "package": "com.fetch.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native"
    ]
  }
}
